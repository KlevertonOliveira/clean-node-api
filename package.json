{
  "name": "clean-node-api",
  "version": "1.0.0",
  "description": "",
  "main": "src/main/index.ts",
  "scripts": {
    "dev": "tsx watch src/main/index.ts",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --silent --reporter=minimal --passWithNoTests",
    "test:c": "npm run test -- --changed --watch",
    "test:unit": "npm test -- --watch --changed --project=unit",
    "test:int": "npm test -- --watch --changed --project=integration",
    "test:staged": "npm test -- related",
    "test:ci": "npm test -- --coverage",
    "test:coverage:ui": "vitest --coverage",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KlevertonOliveira/clean-node-api.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/KlevertonOliveira/clean-node-api/issues"
  },
  "homepage": "https://github.com/KlevertonOliveira/clean-node-api#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "^11.4.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.9.1",
    "zod": "^4.6.7"
  }
}
