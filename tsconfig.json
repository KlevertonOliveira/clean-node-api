{
  "compilerOptions": {
    "target": "ES2022", // Defines the JavaScript version generated by TypeScript.
    "module": "NodeNext", // Uses the module system compatible with Node.js.
    "moduleResolution": "NodeNext", // Defines how modules and imports are resolved.
    "strict": true, // Enables strict type-checking options.
    "esModuleInterop": true, // Facilitates interoperability between CommonJS and ES Modules.
    "forceConsistentCasingInFileNames": true, // Prevents imports with inconsistent casing.
    "skipLibCheck": true, // Skips type-checking of declaration files (.d.ts).
    "outDir": "dist", // Defines the output directory for compiled JavaScript files.
    "rootDir": ".", // Defines the root directory of files included in compilation.
    "types": ["node"] // Includes Node.js type definitions.
  },
  "include": [
    "src/**/*.ts" // Includes all TypeScript files inside src.
  ],
  "exclude": [
    "node_modules", // Excludes installed dependencies.
    "dist" // Excludes compiled output files.
  ]
}
